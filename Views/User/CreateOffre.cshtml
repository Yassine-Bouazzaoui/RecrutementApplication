@model RecrutementApplication.Models.Offre

@{
    ViewData["Title"] = "Créer une Offre";
}
<head>
<link href="~/css/CreateOffre.css" rel="stylesheet" type="text/css" />
    </head>


<div class="page-container">
    <div class="card">
        <h1 class="page-title">
            <i class="fas fa-briefcase"></i> Créer une Nouvelle Offre
        </h1>

        @using (Html.BeginForm("CreateOffre", "User", FormMethod.Post, new { @class = "offer-form" }))
        {
            <div class="form-row">
                <div class="form-group">
                    @Html.LabelFor(m => m.Poste, "Intitulé du poste", new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.Poste, new { @class = "form-control", required = "required", placeholder = "Intitulé du poste" })
                    @Html.ValidationMessageFor(m => m.Poste, "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.Secteur, "Secteur d'activité", new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.Secteur, new { @class = "form-control", required = "required", placeholder = "Secteur de l'offre" })
                    @Html.ValidationMessageFor(m => m.Secteur, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    @Html.LabelFor(m => m.Type, "Type de contrat", new { @class = "form-label" })
                    @Html.DropDownListFor(m => m.Type, new SelectList(Enum.GetValues(typeof(RecrutementApplication.Models.TypeContrat))), new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Type, "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.Profil, "Profil requis", new { @class = "form-label" })
                    @Html.DropDownListFor(m => m.Profil, new SelectList(Enum.GetValues(typeof(RecrutementApplication.Models.Profile))), "-- Sélectionnez un profil --", new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Profil, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    @Html.LabelFor(m => m.Location, "Localisation", new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.Location, new { @class = "form-control", required = "required", placeholder = "Lieu de travail" })
                    @Html.ValidationMessageFor(m => m.Location, "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.Remuneration, "Rémunération", new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.Remuneration, new { @class = "form-control", required = "required", placeholder = "Montant de la rémunération" })
                    @Html.ValidationMessageFor(m => m.Remuneration, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.Description, "Description de l'offre", new { @class = "form-label" })
                @Html.TextAreaFor(m => m.Description, new { @class = "form-control", rows = 4, required = "required", placeholder = "Description complète de l'offre" })
                @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.Responsibilites, "Responsabilités", new { @class = "form-label" })
                @Html.TextAreaFor(m => m.Responsibilites, new { @class = "form-control", rows = 3, required = "required", placeholder = "Liste des responsabilités" })
                @Html.ValidationMessageFor(m => m.Responsibilites, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.Qualifications, "Qualifications requises", new { @class = "form-label" })
                @Html.TextAreaFor(m => m.Qualifications, new { @class = "form-control", rows = 3, required = "required", placeholder = "Liste des qualifications" })
                @Html.ValidationMessageFor(m => m.Qualifications, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.DeadLine, "Date limite de candidature", new { @class = "form-label" })
                @Html.TextBoxFor(m => m.DeadLine, new { @class = "form-control", type = "date", required = "required" })
                @Html.ValidationMessageFor(m => m.DeadLine, "", new { @class = "text-danger" })
            </div>

            <div class="actions">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save"></i> Enregistrer
                </button>
                <a href="@Url.Action("Index", "Offres")" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Retour
                </a>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/js/all.min.js"></script>
    <script>
        // Animation simple
        document.addEventListener('DOMContentLoaded', function() {
            // Focus sur le premier champ de saisie
            document.querySelector('.form-control').focus();

            // Effet de transition sur les champs lors de la saisie
            const inputs = document.querySelectorAll('.form-control');
            inputs.forEach(input => {
                input.addEventListener('focus', function() {
                    this.parentElement.style.transition = 'transform 0.3s';
                    this.parentElement.style.transform = 'translateX(5px)';
                });

                input.addEventListener('blur', function() {
                    this.parentElement.style.transform = 'translateX(0)';
                });
            });
        });
    </script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}